# Rentular browser tests, one run. Started by rentular-e2e.timer.
# Install: see docs/TESTING-OPERATIONS.md
[Unit]
Description=Rentular browser tests
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=e2e
Group=e2e
EnvironmentFile=/etc/rentular-e2e.env
ExecStart=/home/e2e/rentular/e2e/ops/nightly.sh
# Stay in the background: low CPU and IO priority and a hard cap, so a run
# never competes with anything else on the host.
Nice=10
IOSchedulingClass=idle
CPUQuota=150%
MemoryMax=4G
TimeoutStartSec=90min
