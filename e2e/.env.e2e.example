# Settings for the Rentular browser tests.
#
# You normally do not copy this file by hand. e2e/run-local.sh and
# e2e/run-compose.sh create e2e/.env.e2e.local (gitignored) on the first run
# and fill every secret with a fresh random value. The real file stays on the
# machine that runs the tests; never commit it and never paste it in a ticket.
#
# Only edit e2e/.env.e2e.local when you run the tests against an already
# deployed staging or test instance (see "Remote mode" in
# docs/TESTING-OPERATIONS.md). Never point it at the production site.

# ----- Secrets for the throwaway local stack (generated) -----
E2E_DB_ROOT_PASSWORD=<generated>
E2E_DB_PASSWORD=<generated>
E2E_AUTH_SECRET=<generated>

# ----- Test accounts (generated passwords) -----
# Landlord with onboarding done: 1 property, 1 tenant, 1 contract, payments.
E2E_LANDLORD_EMAIL=landlord@e2e.local
E2E_LANDLORD_PASSWORD=<generated>
# Fresh account that still has to go through onboarding. The runner creates
# one per browser project (onboarding+chromium-desktop@e2e.local and so on)
# with this same password.
E2E_ONBOARDING_EMAIL=onboarding@e2e.local
E2E_ONBOARDING_PASSWORD=<generated>

# ----- Ports on 127.0.0.1 for run-local.sh (change if they clash) -----
E2E_WEB_PORT=3410
E2E_API_PORT=4410
E2E_DB_PORT=33306
E2E_REDIS_PORT=36379
E2E_SMTP_PORT=31025
E2E_MAIL_UI_PORT=38025

# ----- Remote mode (optional) -----
# Set both to test an already running staging instance instead of a local
# stack. The accounts above must already exist there. rentular.com is refused.
# E2E_BASE_URL=https://staging.example.org
# E2E_API_URL=https://staging.example.org/api/v1

# ----- Which browsers to run (default: all four) -----
# E2E_PROJECTS=chromium-desktop,chromium-mobile,webkit-desktop,webkit-mobile
